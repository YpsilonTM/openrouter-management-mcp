{
  "name": "openrouter-management-mcp",
  "version": "2.0.0",
  "description": "MCP server for the OpenRouter Management API (keys, workspaces, guardrails, BYOK, org, observability, SCIM, analytics, …)",
  "type": "module",
  "bin": {
    "openrouter-management-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && tsx --test test/*.test.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "openrouter",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
