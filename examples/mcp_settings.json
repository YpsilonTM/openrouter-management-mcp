{
  "mcpServers": {
    "openrouter-management": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/YpsilonTM/openrouter-management-mcp",
        "openrouter-management-mcp"
      ],
      "env": {
        "OPENROUTER_MANAGEMENT_API_KEY": "${OPENROUTER_MANAGEMENT_API_KEY}",
        "OPENROUTER_MGMT_LOG_LEVEL": "${OPENROUTER_MGMT_LOG_LEVEL}"
      },
      "enabled": true,
      "visibility": "public"
    }
  },
  "_comment": "Bind OPENROUTER_MANAGEMENT_API_KEY via MCPHub per-user credentials. Mirror the env name on the mcphub service in ~/docker/ai."
}
